import sys
from math import hypot

EPS = 1e-4

def same(p, q):
    return abs(p[0] - q[0]) < EPS and abs(p[1] - q[1]) < EPS

def cross(o, a, b):
    return (a[0]-o[0]) * (b[1]-o[1]) - (a[1]-o[1]) * (b[0]-o[0])

def hull(pts):
    pts = sorted(set(pts))
    res = []
    for seq in (pts, pts[::-1]):
        h = []
        for p in seq:
            while len(h) > 1 and cross(h[-2], h[-1], p) <= EPS:
                h.pop()
            h.append(p)
        res += h[:-1]
    return res

def center(poly):
    return (sum(p[0] for p in poly) / len(poly),
            sum(p[1] for p in poly) / len(poly))

def reflect(p, c, nx, ny):
    d = 2 * ((p[0]-c[0]) * nx + (p[1]-c[1]) * ny)
    return (p[0] - d*nx, p[1] - d*ny)

def axes(poly, c):
    """Unit normals of all symmetry axes of the current shape."""
    k = len(poly)
    cand = list(poly)
    for i in range(k):
        a, b = poly[i], poly[(i+1) % k]
        cand.append(((a[0]+b[0]) / 2, (a[1]+b[1]) / 2))
    res = []
    for p in cand:
        vx, vy = p[0]-c[0], p[1]-c[1]
        L = hypot(vx, vy)
        nx, ny = -vy/L, vx/L
        if any(abs(nx*my - ny*mx) < 1e-3 for mx, my in res):
            continue
        if all(any(same(reflect(v, c, nx, ny), w) for w in poly) for v in poly):
            res.append((nx, ny))
    return res

def clip(poly, c, nx, ny):
    """Part of the shape on the non-negative side of the fold line."""
    res = []
    k = len(poly)
    for i in range(k):
        a, b = poly[i], poly[(i+1) % k]
        da = (a[0]-c[0]) * nx + (a[1]-c[1]) * ny
        db = (b[0]-c[0]) * nx + (b[1]-c[1]) * ny
        if da > -EPS:
            res.append(a)
        if (da > EPS and db < -EPS) or (da < -EPS and db > EPS):
            t = da / (da - db)
            res.append((a[0] + t*(b[0]-a[0]), a[1] + t*(b[1]-a[1])))
    return res

def fold(segs, c, nx, ny):
    """segs: list of (p, q, full, cost). Returns None if the fold is invalid."""
    keep, move = [], []
    for p, q, full, cost in segs:
        d1 = (p[0]-c[0]) * nx + (p[1]-c[1]) * ny
        d2 = (q[0]-c[0]) * nx + (q[1]-c[1]) * ny
        lo, hi = min(d1, d2), max(d1, d2)
        if lo < -EPS and hi > EPS:          # line crosses the cut
            return None
        if hi <= EPS and lo >= -EPS:        # cut lies along the line
            return None
        if hi > EPS:
            keep.append((p, q, full, cost))
        else:
            move.append((reflect(p, c, nx, ny), reflect(q, c, nx, ny), full, cost))

    res = []
    used = [False] * len(keep)
    for p, q, full, cost in move:
        for i, (a, b, f2, c2) in enumerate(keep):
            if not used[i] and ((same(p, a) and same(q, b)) or
                                (same(p, b) and same(q, a))):
                used[i] = True
                if full and f2:             # every layer needs it: one cut
                    res.append((a, b, True, 1))
                else:
                    res.append((a, b, False, cost + c2))
                break
        else:                               # no partner: cut before folding
            res.append((p, q, False, cost))
    for i, (a, b, f2, c2) in enumerate(keep):
        if not used[i]:
            res.append((a, b, False, c2))
    return res

def rnd(p):
    return (round(p[0], 3), round(p[1], 3))

def main():
    data = sys.stdin.read().split()
    n = int(data[0])
    v = list(map(float, data[1:1 + 4*n]))
    lines = [((v[i], v[i+1]), (v[i+2], v[i+3])) for i in range(0, 4*n, 4)]
    square = hull([p for s in lines for p in s])
    corners = set(square)
    segs = [(p, q, True, 1) for p, q in lines
            if not (p in corners and q in corners)]

    best = len(segs)
    seen = {}

    def dfs(poly, segs, depth):
        nonlocal best
        total = depth + sum(s[3] for s in segs)
        if total < best:
            best = total
        m = sum(1 for s in segs if s[2])    # positions that can still merge
        if m < 2:
            return
        fixed = total - m                   # cost that can never shrink
        k, bound = 1, 10**9
        while True:                         # best case: each fold halves m
            h = (m + (1 << k) - 1) >> k
            bound = min(bound, fixed + k + h)
            if h == 1:
                break
            k += 1
        if bound >= best:
            return
        c = center(poly)
        for nx, ny in axes(poly, c):
            new = fold(segs, c, nx, ny)
            if new is None:
                continue
            # keeping either half gives mirror-image states, so keep one
            shape = clip(poly, c, nx, ny)
            key = (tuple(sorted(map(rnd, shape))),
                   tuple(sorted((*sorted((rnd(p), rnd(q))), f, k)
                                for p, q, f, k in new)))
            if seen.get(key, 99) <= depth + 1:
                continue
            seen[key] = depth + 1
            dfs(shape, new, depth + 1)

    dfs(square, segs, 0)
    print(best, end="")

main()
