import java.util.Arrays;
import java.util.Scanner;
class binarySearch{
    public static void main(String[] args){
        int [] arr={7,8,9,4,5,6,1,2,3};
        Arrays.sort(arr);

        int n= arr.length;
        Scanner scan=new Scanner(System.in);
        System.out.println("Enter the element to find in to search");
        int a= scan.nextInt();
        int high=n-1;
        int low=0;
        int found=0;
        while(low<=high){
         int mid= low +(high-low)/2;
         if(arr[mid]==a){
            found=mid;
            break;
            
         }
         else if (arr[mid]<a){
            low=mid+1;

         }
         else{
            high=mid-1;
         }
        }
   
        if (found !=0){
         System.out.println("Got the element:" + arr[found]);
          System.out.println("Index of the element: " + found);
        }
        else{
           System.out.println("Element not found");
        }
             }
               
           }
     
