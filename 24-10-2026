import java.util.Arrays;
import java.util.Scanner;
class binarySearch{
    public static void main(String[] args){
        int [] arr={7,8,9,4,5,6,1,2,3};
        Arrays.sort(arr);

        int n= arr.length;
        Scanner scan=new Scanner(System.in);
        System.out.println("Enter the element to find in to search");
        int a= scan.nextInt();
        int c=n/2;
        if(a>c){
           for (int i = c; i < n; i++) {
             
             if(arr[i]==a ){
                System.out.print("Got the element "+arr[i]);
                System.out.println("The index of the element"+i);
             }
            }
        }
        if(a<c){
           for (int j = 0; j < c; j++) {
             
             if(arr[j]==a ){
                System.out.println("Got the element "+arr[j]);
                System.out.println("The index of the element"+j);
             }
               
           }
        }
    }}
