import java.util.LinkedList;
import java.util.Queue;

public class Main {
    public static void main(String[] args) {
        // Create a Queue using a LinkedList implementation
        Queue<Integer> queue = new LinkedList<>();

        // PUSH (Enqueue): Add elements to the back of the queue
        queue.offer(10);
        queue.offer(20);
        queue.offer(30);
        System.out.println("Queue after pushes: " + queue);

        // POP (Dequeue): Remove and return the front element
        int poppedElement = queue.poll(); 
        
        System.out.println("Popped element: " + poppedElement);
        System.out.println("Queue after pop: " + queue);
    }
}
